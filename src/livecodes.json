{
  "title": "Blank Project",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Countdown Timer</title>\n    <script\n      crossorigin\n      src=\"https://unpkg.com/react@18/umd/react.production.min.js\"\n    ></script>\n    <script\n      crossorigin\n      src=\"https://unpkg.com/react-dom@18/umd/react-dom.production.min.js\"\n    ></script>\n    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      body {\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Roboto\",\n          \"Oxygen\", \"Ubuntu\", \"Cantarell\", \"Fira Sans\", \"Droid Sans\",\n          \"Helvetica Neue\", sans-serif;\n        background: linear-gradient(\n          135deg,\n          #0f172a 0%,\n          #1e293b 50%,\n          #0f172a 100%\n        );\n        min-height: 100vh;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 20px;\n      }\n\n      #root {\n        width: 100%;\n        max-width: 800px;\n      }\n\n      .container {\n        width: 100%;\n      }\n\n      .header {\n        text-align: center;\n        margin-bottom: 40px;\n        animation: slideDown 0.6s ease-out;\n      }\n\n      @keyframes slideDown {\n        from {\n          opacity: 0;\n          transform: translateY(-20px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n\n      .header h1 {\n        font-size: 3.5rem;\n        font-weight: 800;\n        background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);\n        -webkit-background-clip: text;\n        -webkit-text-fill-color: transparent;\n        background-clip: text;\n        margin-bottom: 10px;\n        letter-spacing: -1px;\n      }\n\n      .header p {\n        font-size: 1.1rem;\n        color: #94a3b8;\n        font-weight: 500;\n      }\n\n      .timers-container {\n        display: flex;\n        flex-direction: column;\n        gap: 20px;\n        margin-bottom: 30px;\n        animation: fadeIn 0.8s ease-out;\n      }\n\n      @keyframes fadeIn {\n        from {\n          opacity: 0;\n        }\n        to {\n          opacity: 1;\n        }\n      }\n\n      .timer-card {\n        background: rgba(30, 41, 59, 0.5);\n        backdrop-filter: blur(10px);\n        border: 1px solid rgba(148, 163, 184, 0.2);\n        border-radius: 24px;\n        padding: 32px;\n        transition: all 0.3s ease;\n        animation: scaleIn 0.5s ease-out;\n      }\n\n      @keyframes scaleIn {\n        from {\n          opacity: 0;\n          transform: scale(0.95);\n        }\n        to {\n          opacity: 1;\n          transform: scale(1);\n        }\n      }\n\n      .timer-card:hover {\n        border-color: rgba(148, 163, 184, 0.4);\n        background: rgba(30, 41, 59, 0.7);\n      }\n\n      .timer-name {\n        font-size: 1.5rem;\n        font-weight: 700;\n        color: #f1f5f9;\n        background: transparent;\n        border: none;\n        border-bottom: 2px solid transparent;\n        width: 100%;\n        padding: 8px 0;\n        margin-bottom: 24px;\n        cursor: text;\n        transition: border-color 0.3s ease;\n      }\n\n      .timer-name:hover {\n        border-bottom-color: rgba(148, 163, 184, 0.3);\n      }\n\n      .timer-name:focus {\n        outline: none;\n        border-bottom-color: #06b6d4;\n      }\n\n      .time-display {\n        text-align: center;\n        margin-bottom: 32px;\n      }\n\n      .time-value {\n        font-size: 4.5rem;\n        font-weight: 900;\n        font-family: \"Courier New\", monospace;\n        letter-spacing: 8px;\n        color: #cbd5e1;\n        transition: color 0.3s ease;\n      }\n\n      .time-value.active {\n        color: #06b6d4;\n        text-shadow: 0 0 20px rgba(6, 182, 212, 0.5);\n      }\n\n      .controls-grid {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: 20px;\n        margin-bottom: 24px;\n      }\n\n      .time-control {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n      }\n\n      .time-label {\n        font-size: 0.75rem;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        color: #64748b;\n        font-weight: 700;\n        margin-bottom: 12px;\n      }\n\n      .time-input-group {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n      }\n\n      .time-btn {\n        width: 36px;\n        height: 36px;\n        border: none;\n        background: #475569;\n        color: #cbd5e1;\n        border-radius: 8px;\n        cursor: pointer;\n        font-size: 16px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        transition: all 0.2s ease;\n        font-weight: 600;\n      }\n\n      .time-btn:hover:not(:disabled) {\n        background: #64748b;\n        transform: scale(1.05);\n      }\n\n      .time-btn:disabled {\n        opacity: 0.4;\n        cursor: not-allowed;\n      }\n\n      .time-input {\n        width: 60px;\n        text-align: center;\n        background: #475569;\n        color: #f1f5f9;\n        border: none;\n        border-radius: 8px;\n        padding: 8px 12px;\n        font-size: 1.2rem;\n        font-weight: 700;\n        transition: all 0.2s ease;\n      }\n\n      .time-input:hover:not(:disabled) {\n        background: #64748b;\n      }\n\n      .time-input:focus:not(:disabled) {\n        outline: none;\n        background: #64748b;\n        box-shadow: 0 0 0 2px #06b6d4;\n      }\n\n      .time-input:disabled {\n        opacity: 0.6;\n        cursor: not-allowed;\n      }\n\n      .progress-bar {\n        width: 100%;\n        height: 3px;\n        background: rgba(71, 85, 105, 0.3);\n        border-radius: 999px;\n        margin-bottom: 24px;\n        overflow: hidden;\n      }\n\n      .progress-fill {\n        height: 100%;\n        background: linear-gradient(90deg, #06b6d4 0%, #3b82f6 100%);\n        border-radius: 999px;\n        transition: width 0.3s ease;\n      }\n\n      .buttons {\n        display: flex;\n        gap: 12px;\n        justify-content: center;\n        flex-wrap: wrap;\n      }\n\n      button {\n        font-family: inherit;\n        font-weight: 600;\n        border: none;\n        border-radius: 10px;\n        padding: 12px 24px;\n        cursor: pointer;\n        transition: all 0.2s ease;\n        font-size: 0.95rem;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 8px;\n        white-space: nowrap;\n      }\n\n      .btn-start {\n        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);\n        color: white;\n        flex: 1;\n        min-width: 120px;\n      }\n\n      .btn-start:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 8px 16px rgba(6, 182, 212, 0.3);\n      }\n\n      .btn-pause {\n        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);\n        color: white;\n        flex: 1;\n        min-width: 120px;\n      }\n\n      .btn-pause:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 8px 16px rgba(249, 115, 22, 0.3);\n      }\n\n      .btn-reset {\n        background: #475569;\n        color: #cbd5e1;\n        flex: 1;\n        min-width: 120px;\n      }\n\n      .btn-reset:hover {\n        background: #64748b;\n        transform: translateY(-2px);\n      }\n\n      .btn-delete {\n        background: rgba(239, 68, 68, 0.2);\n        color: #fca5a5;\n        flex: 1;\n        min-width: 120px;\n      }\n\n      .btn-delete:hover {\n        background: rgba(239, 68, 68, 0.3);\n        transform: translateY(-2px);\n      }\n\n      .add-timer-btn {\n        width: 100%;\n        padding: 16px;\n        font-size: 1.05rem;\n        background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);\n        color: white;\n        font-weight: 700;\n        letter-spacing: 0.5px;\n        animation: slideUp 0.6s ease-out;\n      }\n\n      @keyframes slideUp {\n        from {\n          opacity: 0;\n          transform: translateY(20px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n\n      .add-timer-btn:hover {\n        transform: translateY(-3px);\n        box-shadow: 0 12px 24px rgba(6, 182, 212, 0.3);\n      }\n\n      .add-timer-btn:active {\n        transform: translateY(-1px);\n      }\n\n      @media (max-width: 600px) {\n        .header h1 {\n          font-size: 2.5rem;\n        }\n\n        .timer-card {\n          padding: 24px;\n        }\n\n        .time-value {\n          font-size: 3.5rem;\n          letter-spacing: 4px;\n        }\n\n        .controls-grid {\n          gap: 12px;\n        }\n\n        .buttons {\n          gap: 8px;\n        }\n\n        button {\n          padding: 10px 16px;\n          font-size: 0.85rem;\n        }\n      }\n\n      /* Icon styles */\n      .icon {\n        width: 18px;\n        height: 18px;\n        display: inline-block;\n      }\n    </style>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n\n    <script type=\"text/babel\">\n      const { useState, useEffect, useRef } = React;\n\n      function CountdownTimer() {\n        const [timeLeft, setTimeLeft] = useState({\n          days: 0,\n          hours: 0,\n          minutes: 0,\n          seconds: 0,\n          isActive: true,\n        });\n\n        // Calculate time to May 4th, 2026\n        useEffect(() => {\n          const updateCountdown = () => {\n            const now = new Date();\n            const targetDate = new Date(2026, 4, 4, 0, 0, 0); // May 4, 2026 at midnight\n            const difference = targetDate - now;\n\n            if (difference <= 0) {\n              playSound();\n              setTimeLeft({\n                days: 0,\n                hours: 0,\n                minutes: 0,\n                seconds: 0,\n                isActive: false,\n              });\n              return;\n            }\n\n            const days = Math.floor(difference / (1000 * 60 * 60 * 24));\n            const hours = Math.floor((difference / (1000 * 60 * 60)) % 24);\n            const minutes = Math.floor((difference / 1000 / 60) % 60);\n            const seconds = Math.floor((difference / 1000) % 60);\n\n            setTimeLeft({\n              days,\n              hours,\n              minutes,\n              seconds,\n              isActive: true,\n            });\n          };\n\n          updateCountdown();\n          const interval = setInterval(updateCountdown, 1000);\n          return () => clearInterval(interval);\n        }, []);\n\n        const playSound = () => {\n          try {\n            const audioContext = new (window.AudioContext ||\n              window.webkitAudioContext)();\n            const oscillator = audioContext.createOscillator();\n            const gainNode = audioContext.createGain();\n\n            oscillator.connect(gainNode);\n            gainNode.connect(audioContext.destination);\n\n            oscillator.frequency.value = 800;\n            oscillator.type = \"sine\";\n\n            gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(\n              0.01,\n              audioContext.currentTime + 0.5,\n            );\n\n            oscillator.start(audioContext.currentTime);\n            oscillator.stop(audioContext.currentTime + 0.5);\n          } catch (e) {\n            console.log(\"Audio context not available\");\n          }\n        };\n\n        const formatTime = (value) => {\n          return String(value).padStart(2, \"0\");\n        };\n\n        return (\n          <div className=\"container\">\n            <div className=\"header\">\n              <h1>May 4th</h1>\n              <p>Countdown to the big day</p>\n            </div>\n\n            <div className=\"timers-container\">\n              <div className=\"timer-card\">\n                <div style={{ textAlign: \"center\", marginBottom: \"40px\" }}>\n                  <div\n                    style={{\n                      fontSize: \"0.9rem\",\n                      color: \"#94a3b8\",\n                      marginBottom: \"16px\",\n                      letterSpacing: \"2px\",\n                      textTransform: \"uppercase\",\n                      fontWeight: \"600\",\n                    }}\n                  >\n                    Time Remaining\n                  </div>\n                  <div\n                    style={{\n                      display: \"grid\",\n                      gridTemplateColumns: \"repeat(4, 1fr)\",\n                      gap: \"16px\",\n                    }}\n                  >\n                    <div style={{ textAlign: \"center\" }}>\n                      <div\n                        style={{\n                          fontSize: \"3.5rem\",\n                          fontWeight: \"900\",\n                          color: \"#06b6d4\",\n                          fontFamily: \"Courier New, monospace\",\n                          marginBottom: \"8px\",\n                          textShadow: \"0 0 20px rgba(6, 182, 212, 0.5)\",\n                        }}\n                      >\n                        {formatTime(timeLeft.days)}\n                      </div>\n                      <div\n                        style={{\n                          fontSize: \"0.75rem\",\n                          color: \"#64748b\",\n                          textTransform: \"uppercase\",\n                          letterSpacing: \"1px\",\n                          fontWeight: \"700\",\n                        }}\n                      >\n                        Days\n                      </div>\n                    </div>\n\n                    <div style={{ textAlign: \"center\" }}>\n                      <div\n                        style={{\n                          fontSize: \"3.5rem\",\n                          fontWeight: \"900\",\n                          color: \"#06b6d4\",\n                          fontFamily: \"Courier New, monospace\",\n                          marginBottom: \"8px\",\n                          textShadow: \"0 0 20px rgba(6, 182, 212, 0.5)\",\n                        }}\n                      >\n                        {formatTime(timeLeft.hours)}\n                      </div>\n                      <div\n                        style={{\n                          fontSize: \"0.75rem\",\n                          color: \"#64748b\",\n                          textTransform: \"uppercase\",\n                          letterSpacing: \"1px\",\n                          fontWeight: \"700\",\n                        }}\n                      >\n                        Hours\n                      </div>\n                    </div>\n\n                    <div style={{ textAlign: \"center\" }}>\n                      <div\n                        style={{\n                          fontSize: \"3.5rem\",\n                          fontWeight: \"900\",\n                          color: \"#06b6d4\",\n                          fontFamily: \"Courier New, monospace\",\n                          marginBottom: \"8px\",\n                          textShadow: \"0 0 20px rgba(6, 182, 212, 0.5)\",\n                        }}\n                      >\n                        {formatTime(timeLeft.minutes)}\n                      </div>\n                      <div\n                        style={{\n                          fontSize: \"0.75rem\",\n                          color: \"#64748b\",\n                          textTransform: \"uppercase\",\n                          letterSpacing: \"1px\",\n                          fontWeight: \"700\",\n                        }}\n                      >\n                        Minutes\n                      </div>\n                    </div>\n\n                    <div style={{ textAlign: \"center\" }}>\n                      <div\n                        style={{\n                          fontSize: \"3.5rem\",\n                          fontWeight: \"900\",\n                          color: \"#06b6d4\",\n                          fontFamily: \"Courier New, monospace\",\n                          marginBottom: \"8px\",\n                          textShadow: \"0 0 20px rgba(6, 182, 212, 0.5)\",\n                        }}\n                      >\n                        {formatTime(timeLeft.seconds)}\n                      </div>\n                      <div\n                        style={{\n                          fontSize: \"0.75rem\",\n                          color: \"#64748b\",\n                          textTransform: \"uppercase\",\n                          letterSpacing: \"1px\",\n                          fontWeight: \"700\",\n                        }}\n                      >\n                        Seconds\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"progress-bar\">\n                  <div\n                    className=\"progress-fill\"\n                    style={{ width: timeLeft.isActive ? \"100%\" : \"0%\" }}\n                  ></div>\n                </div>\n\n                <div\n                  style={{\n                    textAlign: \"center\",\n                    padding: \"24px\",\n                    background: \"rgba(6, 182, 212, 0.1)\",\n                    borderRadius: \"12px\",\n                    marginBottom: \"0\",\n                  }}\n                >\n                  <p\n                    style={{\n                      color: \"#cbd5e1\",\n                      fontSize: \"1.1rem\",\n                      fontWeight: \"500\",\n                      margin: \"0\",\n                    }}\n                  >\n                    Monday, May 4th, 2026\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n        );\n      }\n\n      const root = ReactDOM.createRoot(document.getElementById(\"root\"));\n      root.render(<CountdownTimer />);\n    </script>\n  </body>\n</html>\n"
  },
